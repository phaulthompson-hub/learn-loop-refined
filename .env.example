# Optional: docker compose works without a .env file. Copy to .env to override the defaults.

# Tutor mode: "demo" answers locally from the course sources (no network); "openai" calls an
# OpenAI-compatible endpoint and falls back to the local answer if the call fails.
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///./learnloop.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
VITE_API_URL=http://localhost:8000/api

# Pin "now" for reproducible screens (leave empty to use the real clock).
FROZEN_NOW=2022-03-14T09:00:00Z
# Seed the demo workspaces on startup when the database is empty.
SEED_ON_START=true
